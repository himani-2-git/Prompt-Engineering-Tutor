# Copy to .streamlit/secrets.toml for local use (that file is git-ignored),
# or paste these into Streamlit Community Cloud -> App settings -> Secrets.
# You only need ONE key to start; more keys = more failover capacity.

GROQ_API_KEY   = "gsk_..."      # https://console.groq.com/keys   (free, no card)
GEMINI_API_KEY = "AIza..."      # https://aistudio.google.com/apikey (free, no card)

# Optional ---------------------------------------------------------------
# Order of "provider:model" tried. First that works answers. Edit this (no code
# change) when a model is retired. Run scripts/check_models.py to see valid IDs.
# LLM_CHAIN = "groq:llama-3.3-70b-versatile,gemini:gemini-flash-latest,groq:openai/gpt-oss-120b"

# Max questions per hour across ALL visitors (protects your free quota)
# GLOBAL_HOURLY_LIMIT = 300
